{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSL USB Identity Manager",
  "identifier": "io.github.tanakamasayuki.wsl-usb-identity-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WSL USB Identity Manager",
        "visible": false,
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "TANAKA Masayuki",
    "homepage": "https://github.com/tanakamasayuki/wsl-usb-identity-manager",
    "copyright": "Copyright (c) 2026 TANAKA Masayuki",
    "licenseFile": "../LICENSE",
    "shortDescription": "Track which physical device is which when forwarding USB devices to WSL",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
